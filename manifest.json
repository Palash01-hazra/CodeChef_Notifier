{
  "name": "notify-verdict",
  "description": "Extension for CodeChef notifications",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": ["https://www.codechef.com/submit/*"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["contentScript.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.codechef.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["jquery-3.7.1.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
